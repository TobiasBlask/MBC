# Copy to .env and fill in.

# Private key of the deployer account (WITHOUT 0x prefix works too, with is fine)
PRIVATE_KEY=

# Optional custom RPCs (defaults are public nodes, rate-limited)
AMOY_RPC_URL=https://rpc-amoy.polygon.technology
POLYGON_RPC_URL=https://polygon-rpc.com

# For contract verification on Polygonscan
POLYGONSCAN_API_KEY=

# USDC address to use in the Marketplace constructor.
# Polygon mainnet (native USDC):  0x3c499c542cEF5E3811e1192ce70d8cC03d5c3359
# Polygon Amoy testnet:            deploy MockUSDC and paste its address here
USDC_ADDRESS=
